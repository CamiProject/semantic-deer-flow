# Alibaba Cloud API Key
# Get it from Alibaba Cloud Console -> Cost Center -> API Key Management
ALIBABA_CLOUD_API_KEY=your-alibaba-cloud-api-key

# Serper API Key (Google Search) - https://serper.dev
SERPER_API_KEY=your-serper-api-key

# TAVILY API Key
TAVILY_API_KEY=your-tavily-api-key

# Jina API Key
JINA_API_KEY=your-jina-api-key

# InfoQuest API Key
INFOQUEST_API_KEY=your-infoquest-api-key
# Browser CORS allowlist for split-origin or port-forwarded deployments (comma-separated exact origins).
# Leave unset when using the unified nginx endpoint, e.g. http://localhost:2026.
# GATEWAY_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional:
# FIRECRAWL_API_KEY=your-firecrawl-api-key
# VOLCENGINE_API_KEY=your-volcengine-api-key
# OPENAI_API_KEY=your-openai-api-key
# GEMINI_API_KEY=your-gemini-api-key
# DEEPSEEK_API_KEY=your-deepseek-api-key
# NOVITA_API_KEY=your-novita-api-key  # OpenAI-compatible, see https://novita.ai
# MINIMAX_API_KEY=your-minimax-api-key  # OpenAI-compatible, see https://platform.minimax.io
# STEPFUN_API_KEY=your-stepfun-api-key  # OpenAI-compatible, see https://platform.stepfun.com
# VLLM_API_KEY=your-vllm-api-key  # OpenAI-compatible

# E2B cloud sandbox API key — required only when using E2BSandboxProvider.
# Sign up at https://e2b.dev/dashboard
# E2B_API_KEY=your-e2b-api-key
# FEISHU_APP_ID=your-feishu-app-id
# FEISHU_APP_SECRET=your-feishu-app-secret

# SLACK_BOT_TOKEN=your-slack-bot-token
# SLACK_APP_TOKEN=your-slack-app-token
# TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# DISCORD_BOT_TOKEN=your-discord-bot-token

# Enable LangSmith to monitor and debug your LLM calls, agent runs, and tool executions.
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=your-langsmith-api-key
# LANGSMITH_PROJECT=your-langsmith-project

# GitHub API Token
# GITHUB_TOKEN=your-github-token

# DeerFlow application database; unrelated to Semantic or tenant databases.
# DATABASE_URL=postgresql://deerflow:password@localhost:5432/deerflow
#
# MySQL Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your-mysql-user
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=semantic_demo

# Read-only SaaS config database used to resolve tenant datasources.
# This host and resolved tenant DB hosts must be reachable from backend services.
# Use host.docker.internal for a Docker-to-host SSH tunnel.
# SAAS_CONFIG_DB_HOST=localhost
# SAAS_CONFIG_DB_PORT=3306
# SAAS_CONFIG_DB_USER=your-readonly-config-user
# SAAS_CONFIG_DB_PASSWORD=your-readonly-config-password
# SAAS_CONFIG_DB_DATABASE=semantic_demo
# Optional neutral registry schema overrides:
# SAAS_CONFIG_DB_TABLE=tenant_datasources
# SAAS_CONFIG_DB_CODE_COLUMN=code
# SAAS_CONFIG_DB_URL_COLUMN=url
# SAAS_CONFIG_DB_USERNAME_COLUMN=username
# SAAS_CONFIG_DB_PASSWORD_COLUMN=password
# SAAS_CONFIG_DB_DRIVER_COLUMN=driver_class

# WECOM_BOT_ID=your-wecom-bot-id
# WECOM_BOT_SECRET=your-wecom-bot-secret
# DINGTALK_CLIENT_ID=your-dingtalk-client-id
# DINGTALK_CLIENT_SECRET=your-dingtalk-client-secret

# LangGraph blocking call configuration (required for Windows development mode)
# LANGGRAPH_ALLOW_BLOCKING=1

# Set to "false" to disable Swagger UI, ReDoc, and OpenAPI schema in production
# GATEWAY_ENABLE_DOCS=false

# SaaS Gateway -> DeerFlow Gateway token (X-DeerFlow-Internal-Token).
# Share across Gateway replicas and the SaaS caller; do not reuse other tokens.
# DEER_FLOW_INTERNAL_AUTH_TOKEN=your-shared-internal-token

# Short-lived X-SaaS-Authorization-Context JWT verification.
# Production should use RS256; `aud` must include both audiences below.
# PEM public keys may use literal \n sequences.
# SAAS_AUTHORIZATION_JWT_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# SAAS_AUTHORIZATION_JWT_ALGORITHMS=RS256
# SAAS_AUTHORIZATION_JWT_ISSUER=saas-gateway
# SAAS_AUTHORIZATION_JWT_AUDIENCE=deerflow
# SAAS_AUTHORIZATION_SEMANTIC_AUDIENCE=semantic-platform
# SAAS_AUTHORIZATION_JWT_MAX_TTL_SECONDS=300
#
# Gateway -> Semantic API token; set the same value on both services.
# DEER_FLOW_SEMANTIC_SERVICE_TOKEN=your-semantic-service-token
# Same-host processes:
# DEER_FLOW_SEMANTIC_API_URL=http://127.0.0.1:8003
# Split-host deployment:
# DEER_FLOW_SEMANTIC_API_URL=https://semantic-api.example.invalid
# Bundled Compose overrides this with http://semantic-api:8003.
# DEER_FLOW_SEMANTIC_TIMEOUT_SECONDS=30
#
# Semantic API and Action Worker must share this database. For bundled Compose,
# leave this unset so both services use the shared semantic-data volume. For
# local processes, the following SQLite path is suitable. Split-host or
# multi-replica deployments require PostgreSQL.
# DEER_FLOW_SEMANTIC_DATABASE_URL=sqlite+aiosqlite:///./.deer-flow/data/semantic.db
# UV_EXTRAS=postgres
# DEER_FLOW_SEMANTIC_DATABASE_URL=postgresql+asyncpg://semantic:password@localhost:5432/semantic_demo
#
# Optional custom definitions. Docker values are container paths.
# DEER_FLOW_ONTOLOGY_PATH=/etc/deerflow/ontology.yaml
# DEER_FLOW_SQL_SCOPE_POLICY_PATH=/etc/deerflow/sql-scope-policy.yaml
#
# Optional large-scope resolver; it must return a signed resource_set JWT.
# SAAS_AUTHORIZATION_SCOPE_RESOLVER_URL=https://iam.example.invalid/api/authorization/resolve-scope
# DEER_FLOW_SEMANTIC_SCOPE_RESOLVER_TOKEN=your-scope-resolver-service-token
#
# SQL fallback mode: scoped, disabled, or role_allowlist.
# DEER_FLOW_SAAS_QUERY_SQL_FALLBACK_MODE=scoped
# DEER_FLOW_SAAS_QUERY_SQL_FALLBACK_ROLES=tenant_admin,data_engineer
# DEER_FLOW_SAAS_QUERY_SHADOW_SQL=false
# DEER_FLOW_SQL_CROSS_VALIDATE_ALLOWED_ROLES=tenant_admin,data_engineer
# Public-only in-memory SQLite tables used by local demos and isolated Evals.
# Disable this before connecting a real tenant datasource registry.
DEER_FLOW_SEMANTIC_DEMO_DATA=true
#
# Action approval JWT; defaults to the authorization JWT key/issuer when unset.
# SAAS_ACTION_APPROVAL_JWT_KEY=your-approval-public-key
# SAAS_ACTION_APPROVAL_JWT_ISSUER=saas-gateway
# SAAS_ACTION_APPROVAL_MAX_TTL_SECONDS=300
#
# Action Worker only: keep Domain API/IAM tokens separate and worker IDs unique.
# DEER_FLOW_ACTIONS_ENABLED controls local startup; Compose always starts Worker.
# DEER_FLOW_ACTIONS_ENABLED=false
# DEER_FLOW_ACTION_WORKER_POLL_SECONDS=1
# DEER_FLOW_ACTION_LEASE_SECONDS=30
# DEER_FLOW_ACTION_WORKER_ID=action-worker-1
# DEER_FLOW_ACTION_WORKER_DOMAIN_API_TOKEN=your-domain-write-service-token
# DEER_FLOW_ACTION_WORKER_AUTHORIZATION_TOKEN=your-iam-revalidation-service-token
# Current Action: PATCH /api/internal/sites/{site_id}/display-name.
# SAAS_DOMAIN_API_BASE_URL=https://domain.example.invalid
# SAAS_ACTION_AUTHORIZATION_REVALIDATION_URL=https://iam.example.invalid/api/authorization/actions/revalidate
# SAAS_ACTION_AUTHORIZATION_AUDIENCE=action-worker
#
# Offline Evals only. Also set config.yaml `evals.enabled: true` and
# `run_events.backend: db`. Never use DEER_FLOW_ENV=eval in production.
# DEER_FLOW_ENV=eval
# EVALS_FIXTURE_BASE_URL=http://127.0.0.1:8004
# EVALS_FIXTURE_TOKEN=your-evals-control-token
# EVALS_SAAS_INTERNAL_TOKEN=your-evals-worker-token
# Used for signing and verification only when DEER_FLOW_ENV=eval; production
# environments continue to use SAAS_AUTHORIZATION_JWT_KEY.
# EVALS_AUTHORIZATION_JWT_KEY=replace-with-at-least-32-random-bytes
# EVALS_AUTHORIZATION_JWT_ALGORITHM=HS256
# DEER_FLOW_EVALS_EVIDENCE_ENABLED=true
#
# ── Frontend SSR → Gateway wiring ─────────────────────────────────────────────
# The Next.js server uses these to reach the Gateway during SSR (auth checks,
# /api/* rewrites). They default to localhost values that match `make dev` and
# `make start`, so most local users do not need to set them.
#
# Override only when the Gateway is not on localhost:8001 (e.g. when the
# frontend and gateway run on different hosts, in containers with a service
# alias, or behind a different port). docker-compose already sets these.
# DEER_FLOW_INTERNAL_GATEWAY_BASE_URL=http://localhost:8001
# DEER_FLOW_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:2026
# Public downstream repository used by frontend GitHub and Issue links.
# NEXT_PUBLIC_REPOSITORY_URL=https://github.com/your-github-account/semantic-deer-flow

# ── Claude Code / Codex CLI subscription as a model provider (optional) ───────
# If you configure a ClaudeChatModel / Codex model provider (or an ACP agent)
# that reuses your CLI subscription login, prefer passing a token via env over
# bind-mounting your whole ~/.claude / ~/.codex into the container. The Gateway
# credential loader reads these first, so no directory mount is needed.
#   CLAUDE_CODE_CREDENTIALS_PATH points at a single .credentials.json (Claude)
#   rather than the whole dir. docker-compose.cli-auth.yaml is the opt-in
#   directory-mount fallback for adapters that need the full CLI config.
#   ACP adapters often take their own env API key (e.g. ANTHROPIC_API_KEY) and
#   need no mount at all — check the adapter's docs. See SECURITY.md.
# CLAUDE_CODE_OAUTH_TOKEN=your-claude-code-oauth-token
# ANTHROPIC_AUTH_TOKEN=your-anthropic-auth-token
# CLAUDE_CODE_CREDENTIALS_PATH=/path/to/.claude/.credentials.json
# CODEX_AUTH_PATH=/path/to/codex/auth.json
